# PostgreSQL connection string (Neon.tech or any asyncpg-compatible host)
DATABASE_URL='postgresql+asyncpg://user:password@host:port/database?sslmode=require'

# Wynncraft API v3 bearer token
WYNN_TOKEN='your-wynncraft-api-token'

# UUID of the guild to track
GUILD_UUID='your-guild-uuid'

# Discord OAuth2 application credentials
DISCORD_CLIENT_ID='your-discord-client-id'
DISCORD_CLIENT_SECRET='your-discord-client-secret'

# Secret used to sign JWTs (generate a random UUID or similar)
JWT_SECRET='replace-with-a-random-secret'

# Secret used during initial admin account setup
SETUP_SECRET='replace-with-a-random-secret'

# Optional: comma-separated Discord user IDs that are auto-authorized
# AUTHORIZED_DISCORD_IDS='123456789,987654321'

# Optional: override the frontend URL used for OAuth redirects.
# When this starts with https:// the JWT cookie is automatically marked Secure.
# FRONTEND_URL='http://localhost:5173'

# Optional: mark the JWT cookie as Secure (HTTPS only). Defaults to true when
# FRONTEND_URL starts with https://, otherwise false. Set explicitly if the
# backend is served over HTTPS while FRONTEND_URL is not an https URL.
# JWT_COOKIE_SECURE='true'

# Optional: SameSite attribute for the JWT cookie: 'lax' (default), 'strict',
# or 'none' (only needed for cross-origin deployments without a proxy; forces
# Secure). A same-origin setup (frontend proxying /api to the backend) is
# recommended instead.
# JWT_COOKIE_SAMESITE='lax'

# Optional: override the Discord OAuth redirect URI
# DISCORD_REDIRECT_URI='http://localhost:8000/api/auth/discord/callback'
